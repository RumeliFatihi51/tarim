NODE_ENV=development
PORT=3000

# Required in production. PostgreSQL is the system of record.
DATABASE_URL=postgresql://terrasat:change-me@localhost:5432/terrasat
# Required in production; use at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-production-secret
CORS_ORIGINS=http://localhost:3000

# LIVE analysis defaults to two public Sentinel-2 L2A STAC catalogs.
SATELLITE_PROVIDER=composite
# Optional; raises Planetary Computer limits.
PLANETARY_COMPUTER_API_KEY=
EXTERNAL_REQUEST_TIMEOUT_MS=30000
MAX_POLYGON_AREA_HA=10000
MAX_POLYGON_VERTICES=5000

# Runtime assistant only. Never exposed through VITE_ variables.
GEMINI_API_KEY=

# Development artifact storage. Production deployments should mount durable storage.
STORAGE_DIR=./data/artifacts
