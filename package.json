{
  "name": "terrasat-ai",
  "private": true,
  "version": "3.0.0",
  "description": "Auditable Sentinel-2 remote sensing and MRV workstation",
  "author": "TerraSat AI Engineering",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run typecheck && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/persistence/migrate.ts",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "build:win": "npm run build && npm run desktop:compile && electron-builder --win --x64 --config desktop/electron-builder.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^7.5.1",
    "express": "^4.21.2",
    "geotiff": "^3.0.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.15.5",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "supertest": "^7.1.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
